# Copy this file to .env for local development. Render uses its own
# dashboard environment variables instead (see render.yaml / README.md).

SECRET_KEY=change-me-to-something-random
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DATABASE_URL unset locally to use SQLite automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional — only needed if you want contact-form leads emailed to you too.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
LEAD_NOTIFICATION_EMAIL=founder.archon@gmail.com
