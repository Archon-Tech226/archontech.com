rules_version = '2';

// Paste this into Firebase Console → Firestore Database → Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      // Anyone visiting the site can read posts.
      allow read: if true;

      // Only a signed-in user can create a post, and only as themselves.
      allow create: if request.auth != null
                    && request.resource.data.authorUid == request.auth.uid
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 600;

      // No edits or deletes from the site for now — keep the history simple.
      allow update, delete: if false;
    }
  }
}
